# Copie este arquivo para ".env" e ajuste os valores.

# Porta da API
PORTA=3000

# Arquivo do banco SQLite (criado automaticamente)
BANCO_ARQUIVO=dados/atletix.sqlite

# Segredo que assina os tokens de acesso (JWT). Obrigatório em produção.
# Deixe vazio em desenvolvimento: a API sorteia um segredo novo a cada inicialização.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=
# Validade do token de acesso, em minutos
TOKEN_DE_ACESSO_MINUTOS=15
# Validade da sessão (token de renovação), em dias
SESSAO_DIAS=7

# Endereço do frontend (CORS e link do e-mail de recuperação de senha)
URL_DO_FRONTEND=http://localhost:5173

# Dados de demonstração criados por "npm run semente".
# Todas as contas de demonstração usam esta senha.
SEMENTE_SENHA=Atletix@2026
